# ---- Required -------------------------------------------------------------
# Token from @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Telegram user IDs allowed to use the bot + dashboard (comma separated).
# Don't know yours? Start the server, send /start to the bot, it replies with your ID.
ADMIN_IDS=111111111
# PostgreSQL: servers, tokens, website accounts, notification history and settings live here.
# aaPanel → Databases → PgSQL → Add database (name, user, password), then:
DATABASE_URL=postgres://watchdog:PASSWORD@127.0.0.1:5432/watchdog

# Tip: "npm run setup" asks for these, checks the port and writes this file for you.

# ---- URLs -----------------------------------------------------------------
# Public HTTPS address of this main server (the aaPanel site). Sub servers send their
# reports here, and it goes into the .env snippet the bot gives you for each sub server.
PUBLIC_URL=https://watchdog.example.com
# The dashboard (Telegram Mini App). Telegram only opens Mini Apps over HTTPS.
WEBAPP_URL=https://watchdog.example.com/app/

# ---- Port -----------------------------------------------------------------
# Local port of the Node app. Pick any free port; aaPanel/nginx forwards HTTPS to it.
# After changing it, run "npm run nginx" and paste the new block into the aaPanel site config.
PORT=8080
# 127.0.0.1 = reachable only through aaPanel/nginx on this machine (recommended).
# 0.0.0.0   = reachable directly on http://SERVER-IP:PORT (then open the port in aaPanel → Security).
HOST=127.0.0.1

# ---- Optional -------------------------------------------------------------
# Extra chats (e.g. a group, IDs start with -100) that also receive alerts
ALERT_CHAT_IDS=
# Time zone for times in Telegram messages, e.g. America/Toronto (empty = the server's own, often UTC)
TIMEZONE=
# Only read once: data of older versions (before PostgreSQL), imported into an empty database
DATA_FILE=data/watchdog.json

# A sub server is "down" after this many seconds without a report
OFFLINE_AFTER_SECONDS=30
# Live history kept for the dashboard charts
HISTORY_MINUTES=60
# Regular health report to Telegram, in minutes (0 = off)
HEALTH_REPORT_INTERVAL_MINUTES=360

# Alert thresholds (0 disables a rule) and how long they must hold
CPU_ALERT_PERCENT=90
CPU_ALERT_FOR_SECONDS=120
RAM_ALERT_PERCENT=90
RAM_ALERT_FOR_SECONDS=120
DISK_ALERT_PERCENT=90
DISK_ALERT_FOR_SECONDS=0
TEMP_ALERT_CELSIUS=80
TEMP_ALERT_FOR_SECONDS=60
# An alert clears only after dropping this far below the threshold
ALERT_HYSTERESIS=5

# Local testing only: open http://localhost:8080/app/ in a normal browser without Telegram login
DEV_NO_AUTH=false

# ---- Auto-update from GitHub ----------------------------------------------
# Works when this main server runs from a git clone of your repo (not in Docker).
AUTO_UPDATE=true
UPDATE_CHECK_MINUTES=30
# Branch to follow (default: the one that is checked out)
UPDATE_BRANCH=
# Only for a private repository: a fine-grained GitHub token with read-only "Contents" access.
UPDATE_GITHUB_TOKEN=

# ---- Sub-server project (separate repo) -------------------------------------
# The sub server lives in its own GitHub repo now (watchdog-sub). The bot builds
# the one-line sub-server installer from this URL, and reads its latest commit
# to show in /version which sub servers are behind. Leave empty to disable the
# one-liner (the .env snippet from /add still works). Use a public repo, or the
# raw.githubusercontent.com installer URL won't work without auth.
SUB_REPO=https://github.com/bababoeiii/WATCHDOG_SUB.git
SUB_BRANCH=main
# Only if SUB_REPO is private and UPDATE_GITHUB_TOKEN has no access to it.
SUB_GITHUB_TOKEN=

# ---- Website (https://YOUR-DOMAIN/ — the home page is the login page) ------
# Notification history, live; accounts with roles (owner / staff / user).
# Owners (ADMIN_IDS) log in with /login in Telegram (one-time link) or the Telegram button
# (for that button, send /setdomain to @BotFather once and enter your domain).
# Days of notification history to keep
NOTIFY_HISTORY_DAYS=30
# How long a login stays valid
PORTAL_SESSION_DAYS=7
# E-mail login codes (optional; without SMTP, accounts use an authenticator app)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender address (default: SMTP_USER)
SMTP_FROM=
# empty = TLS on port 465, STARTTLS otherwise
SMTP_SECURE=
